# PayPal sandbox app credentials (developer.paypal.com > Apps & Credentials > Sandbox)
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com

# Channel3 API key (trychannel3.com). Leave empty to use the built-in demo catalog.
CHANNEL3_API_KEY=

# Currency for search and checkout
CARTPILOT_CURRENCY=USD

# Where PayPal sends the buyer after approving / cancelling.
# In HTTP mode the server serves /paypal/return and /paypal/cancel itself.
PUBLIC_BASE_URL=http://localhost:8000

# SQLite file for policy, product cache and purchase ledger
CARTPILOT_DB=cartpilot.db

# Default spending policy (can be changed later with the set_spending_policy tool)
DEFAULT_PER_ORDER_LIMIT=500
DEFAULT_MONTHLY_LIMIT=1500
